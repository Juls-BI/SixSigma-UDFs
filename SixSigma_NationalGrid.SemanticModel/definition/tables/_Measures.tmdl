	measure 'Grid Frequency' = AVERAGE(Fact_GridFrequency[f])
		displayFolder: status/display text, the KPI value, chart summary & titles
		lineageTag: 12d081d5-8535-44b8-8f66-9d7dc9a13c91

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Control Chart Title' =
			
			VAR _Start = CALCULATE(MIN(Fact_GridFrequency[dtm]), ALLSELECTED(Fact_GridFrequency))
			VAR _End = CALCULATE(MAX(Fact_GridFrequency[dtm]), ALLSELECTED(Fact_GridFrequency))
			RETURN
			    "Control Chart - " & FORMAT(_Start, "dd/mm hh:mm") & " until " & FORMAT(_End, "dd/mm hh:mm")
		displayFolder: status/display text, the KPI value, chart summary & titles
		lineageTag: 8efb27f3-3618-448f-9cea-3dc929b5a2f3

	measure 'Summary Title' =
			
			VAR _Start = CALCULATE(MIN(Fact_GridFrequency[dtm]), ALLSELECTED(Fact_GridFrequency))
			VAR _End = CALCULATE(MAX(Fact_GridFrequency[dtm]), ALLSELECTED(Fact_GridFrequency))
			RETURN
			    "Control Chart - " & FORMAT(_Start, "dd/mm/yyyy hh:mm") & " until " & FORMAT(_End, "dd/mm/yyyy hh:mm")
		displayFolder: status/display text, the KPI value, chart summary & titles
		lineageTag: a696791c-261e-4e91-b487-bafa75c60ab7

	measure 'Chart Subtitle' =
			
			VAR _Table = ALLSELECTED(Fact_GridFrequency)
			RETURN
			    ChartSummary(_Table, Fact_GridFrequency[f], Fact_GridFrequency[dtm], [Current USL], [Current LSL])
		lineageTag: 3078da24-0a1a-413a-809a-69c5062cdb23

	measure 'Data Source Note' =
			
			VAR _USL = SELECTEDVALUE(Dim_GridThresholds[USL])
			VAR _LSL = SELECTEDVALUE(Dim_GridThresholds[LSL])
			VAR _Site = SELECTEDVALUE(Dim_GridThresholds[SiteName], "GB grid")
			RETURN
			    "Data source: National Energy System Operator (NESO) system frequency data (neso.energy/data-portal/system-frequency-data). Statutory operating limits for " & _Site & ": " & FORMAT(_LSL, "0.0") & "–" & FORMAT(_USL, "0.0") & " Hz."
		lineageTag: 1a402047-8c98-424b-b333-01f79808639f

	column Column1
		dataType: string
		isHidden
		lineageTag: b5e26133-9c8b-49fd-bb1e-edc42305a0b2
		summarizeBy: none
		sourceColumn: Column1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

