	measure 'Flagged by Nelson Rule 1' =
			
			VAR _CurrentValue = SELECTEDVALUE(Fact_GridFrequency[f])
			RETURN
			    IF([Is Nelson Rule 1] = TRUE(), _CurrentValue, BLANK())
