	measure 'Is Beyond Statutory Range' =
			
			VAR _CurrentValue = SELECTEDVALUE(Fact_GridFrequency[f])
			VAR _USL = [Current USL]
			VAR _LSL = [Current LSL]
			RETURN
			    IF(
			        ISBLANK(_CurrentValue) || ISBLANK(_USL) || ISBLANK(_LSL),
			        BLANK(),
			        _CurrentValue > _USL || _CurrentValue < _LSL
			    )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: Nelson rules & range-flag measures
		lineageTag: 9ffede0c-32e4-4754-b320-fc763c0b3d8a

	measure 'Flagged Beyond Statutory Range' =
			
			VAR _CurrentValue = SELECTEDVALUE(Fact_GridFrequency[f])
			RETURN
			    IF([Is Beyond Statutory Range] = TRUE(), _CurrentValue, BLANK())
		displayFolder: Nelson rules & range-flag measures
		lineageTag: 2404f4aa-27a2-4cad-9ca2-ad2b04ed818f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sigma Level Status' = ```
			
			VAR _USL = [Current USL]
			VAR _LSL = [Current LSL]
			VAR _Sigma = [Sigma Level Value]
			VAR _Defects = [Defect Count]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_USL) || ISBLANK(_LSL), BLANK(),
			        ISBLANK(_Sigma) && _Defects = 0, "✓ World class",
			        ISBLANK(_Sigma), BLANK(),
			        _Sigma >= 6, "✓ World class",
			        _Sigma >= 5, "✓ Excellent",
			        _Sigma >= 4, "✓ Good",
			        _Sigma >= 3, "⚠ Moderate",
			        _Sigma >= 2, "⚠ Poor",
			        "⚠ Very poor"
			    )
			
			```
		displayFolder: status/display text, the KPI value, chart summary & titles
		lineageTag: 54377d07-4d74-486e-89d3-ceadc4de653b

	measure 'DPMO Status' = [Sigma Level Status]
		displayFolder: status/display text, the KPI value, chart summary & titles
		lineageTag: 61e12bb3-8227-45da-b55c-d78f51ee1bad

	measure 'Cpk Status' =
			
			VAR _Cpk = [Cpk Value]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_Cpk), BLANK(),
			        _Cpk >= 1.33, "✓ Capable",
			        _Cpk >= 1, "✓ Marginal",
			        "⚠ Not capable"
			    )
		displayFolder: status/display text, the KPI value, chart summary & titles
		lineageTag: 8e314ef6-bb73-457c-a728-31354609044c

	measure 'Ppk Status' =
			
			VAR _Ppk = [Ppk Value]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_Ppk), BLANK(),
			        _Ppk >= 1.33, "✓ Capable",
			        _Ppk >= 1, "✓ Marginal",
			        "⚠ Not capable"
			    )
		displayFolder: status/display text, the KPI value, chart summary & titles
		lineageTag: 824d574b-48fe-4fc2-8389-b5163264ee08

	measure 'Sigma Level Display' =
			
			VAR _USL = [Current USL]
			VAR _LSL = [Current LSL]
			VAR _Value = [Sigma Level Value]
			VAR _Defects = [Defect Count]
			RETURN
			    IF(
			        ISBLANK(_USL) || ISBLANK(_LSL),
			        "Threshold pending research",
			        IF(
			            ISBLANK(_Value) && _Defects = 0,
			            "> 6σ",
			            IF(ISBLANK(_Value), "Insufficient data", FORMAT(_Value, "0.0") & "σ")
			        )
			    )
		displayFolder: status/display text, the KPI value, chart summary & titles
		lineageTag: d5640dff-b371-4831-8fac-c9314361571b

	measure 'DPMO Display' =
			
			VAR _USL = [Current USL]
			VAR _LSL = [Current LSL]
			VAR _Value = [DPMO Value]
			VAR _Defects = [Defect Count]
			RETURN
			    IF(
			        ISBLANK(_USL) || ISBLANK(_LSL),
			        "Threshold pending research",
			        IF(ISBLANK(_Defects), "Insufficient data", FORMAT(_Value, "#,0"))
			    )
		displayFolder: status/display text, the KPI value, chart summary & titles
		lineageTag: 416c70a1-1656-487d-8714-caf560c842f3

	measure 'Cpk Display' =
			
			VAR _Value = [Cpk Value]
			RETURN
			    IF(ISBLANK(_Value), "Threshold pending research", FORMAT(_Value, "0.00"))
		displayFolder: status/display text, the KPI value, chart summary & titles
		lineageTag: bada0bb4-dc25-4f84-a1d4-8c9244d60b8b

	measure 'Ppk Display' =
			
			VAR _Value = [Ppk Value]
			RETURN
