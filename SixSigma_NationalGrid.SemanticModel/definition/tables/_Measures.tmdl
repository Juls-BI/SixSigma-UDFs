table _Measures
	lineageTag: 9fee1df9-c685-4491-9f8b-7dc42f3b3f7d

	measure 'Current USL' = SELECTEDVALUE(Dim_GridThresholds[USL])
		displayFolder: thresholds & capability indices
		lineageTag: 36ba0fe6-8785-4d01-a7a8-4cc6c47fa271

	measure 'Current LSL' = SELECTEDVALUE(Dim_GridThresholds[LSL])
		displayFolder: thresholds & capability indices
		lineageTag: e81e34e1-2092-4774-8486-f0e93a013c28

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Defect Count' =
			
			VAR _USL = [Current USL]
			VAR _LSL = [Current LSL]
			RETURN
			    IF(
			        ISBLANK(_USL) || ISBLANK(_LSL),
			        BLANK(),
			        CALCULATE(
			            COUNTROWS(Fact_GridFrequency),
			            FILTER(Fact_GridFrequency, Fact_GridFrequency[f] > _USL || Fact_GridFrequency[f] < _LSL)
			        )
			    )+0
		formatString: 0
		displayFolder: thresholds & capability indices
		lineageTag: 0eb76932-7b89-4e9a-9217-7b484dbc7c9a

	measure 'Unit Count' = COUNTROWS(ALLSELECTED(Fact_GridFrequency))
		formatString: 0
		displayFolder: thresholds & capability indices
		lineageTag: 8d5c41a4-0118-4961-8a59-2aa2cfce94c1

	measure 'DPMO Value' = DPMO([Defect Count], [Unit Count], 1)
		displayFolder: thresholds & capability indices
		lineageTag: 5ebc79f8-7f17-4c4b-9a1d-708a3dd2754a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

